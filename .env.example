PROJECT_NAME=NOCMON
DEBUG=True
API_V1_STR=/api/v1

# Database Configuration (PostgreSQL/PostGIS on host port 5433)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=nocmon_user
POSTGRES_PASSWORD=nocmon_password
POSTGRES_DB=nocmon_db

# Async Database URL for SQLAlchemy (asyncpg)
DATABASE_URL=postgresql+asyncpg://nocmon_user:nocmon_password@localhost:5433/nocmon_db

# Sync Database URL for Alembic migrations (psycopg2)
SYNC_DATABASE_URL=postgresql+psycopg2://nocmon_user:nocmon_password@localhost:5433/nocmon_db

# Telegram Alert Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
